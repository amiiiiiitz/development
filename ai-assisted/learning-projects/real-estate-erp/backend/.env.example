# Application Environment: development | staging | production
ENVIRONMENT=development
APP_NAME=Real Estate ERP API
API_V1_PREFIX=/api/v1

# PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/real_estate_erp

# JWT Configuration (Generate a strong random 64-byte hex string for production)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Strict CORS Allowed Origins (JSON array or comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth Rate Limiting
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Optional Cookie Mode for Refresh Tokens
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
