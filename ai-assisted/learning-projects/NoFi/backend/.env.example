# Variable names and defaults are taken from backend/server.js.
# The backend reads the process environment only (no dotenv). On Node 20.6+:
#   node --env-file=.env server.js
PORT=3001
API_HOST=127.0.0.1
# Comma-separated browser origins allowed by CORS. Default: local dev/preview origins.
FRONTEND_ORIGINS=http://localhost:5173
# Reverse-proxy hops in front of the server. Default: 1 in production, 0 otherwise.
# Set it to the real number of proxies (Render = 1). If nothing sits in front of the server, keep 0,
# otherwise clients could fake their IP address and dodge the rate limits.
TRUST_PROXY_HOPS=0
INFO_RATE_LIMIT_WINDOW_MS=900000
INFO_RATE_LIMIT_MAX=30
CONVERT_RATE_LIMIT_WINDOW_MS=3600000
CONVERT_RATE_LIMIT_MAX=5
MAX_CONCURRENT_CONVERSIONS=2
# Simultaneous video lookups (/api/info). Extra requests get 503 "busy".
MAX_CONCURRENT_LOOKUPS=4
